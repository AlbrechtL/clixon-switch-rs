<clixon-config xmlns="http://clicon.org/config">
  <!-- Generated by "make" from clixon/clixon.xml.in. -->
  <CLICON_CONFIGFILE>@SYSCONFDIR@/clixon.xml</CLICON_CONFIGFILE>
  <!-- Read non-recursively (*.xml only); holds autocli.xml. -->
  <CLICON_CONFIGDIR>@SYSCONFDIR@/clixon/clixon-switch</CLICON_CONFIGDIR>
  <CLICON_FEATURE>ietf-netconf:startup</CLICON_FEATURE>
  <CLICON_FEATURE>clixon-restconf:allow-auth-none</CLICON_FEATURE>
  <CLICON_YANG_DIR>@DATADIR@/clixon</CLICON_YANG_DIR>
  <CLICON_YANG_DIR>@DATADIR@/clixon-switch/yang</CLICON_YANG_DIR>
  <CLICON_YANG_MODULE_MAIN>clixon-switch</CLICON_YANG_MODULE_MAIN>
  <CLICON_CLI_MODE>clixon-switch</CLICON_CLI_MODE>
  <CLICON_CLI_LINESCROLLING>0</CLICON_CLI_LINESCROLLING>
  <CLICON_CLI_TAB_MODE>0</CLICON_CLI_TAB_MODE>
  <CLICON_CLISPEC_DIR>@LIBDIR@/clixon-switch/clispec</CLICON_CLISPEC_DIR>
  <CLICON_BACKEND_DIR>@LIBDIR@/clixon-switch/backend</CLICON_BACKEND_DIR>
  <CLICON_SOCK>@RUNSTATEDIR@/clixon-switch.sock</CLICON_SOCK>
  <CLICON_SOCK_GROUP>clicon</CLICON_SOCK_GROUP>
  <CLICON_BACKEND_PIDFILE>@RUNSTATEDIR@/clixon-switch.pid</CLICON_BACKEND_PIDFILE>
  <!-- Datastores on tmpfs: clixon rewrites candidate_db and running_db on
       every edit. Only startup_db is kept in persistent storage, through a
       symlink set up by prepare-datastore. -->
  <CLICON_XMLDB_DIR>@RUNSTATEDIR@/clixon-switch</CLICON_XMLDB_DIR>
  <CLICON_STARTUP_MODE>startup</CLICON_STARTUP_MODE>
  <!-- RESTCONF. The daemon is started by its own init script and reads the
       <restconf> block below instead of a datastore. -->
  <CLICON_BACKEND_RESTCONF_PROCESS>false</CLICON_BACKEND_RESTCONF_PROCESS>
  <CLICON_RESTCONF_USER>clicon</CLICON_RESTCONF_USER>
  <CLICON_RESTCONF_PRIVILEGES>drop_perm</CLICON_RESTCONF_PRIVILEGES>
  <!-- Explicit save: RESTCONF edits change running only. Persist with the
       CLI "save" command or a copy-config running -> startup. -->
  <CLICON_RESTCONF_STARTUP_DONTUPDATE>true</CLICON_RESTCONF_STARTUP_DONTUPDATE>
  <restconf>
    <enable>true</enable>
    <!-- No authentication and no TLS: proof of concept only. -->
    <auth-type>none</auth-type>
    <pretty>true</pretty>
    <socket>
      <namespace>default</namespace>
      <address>0.0.0.0</address>
      <port>@RESTCONF_PORT@</port>
      <ssl>false</ssl>
    </socket>
  </restconf>
</clixon-config>
